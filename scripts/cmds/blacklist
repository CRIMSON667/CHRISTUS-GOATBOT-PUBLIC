  onChat: async function ({ api, event, message, usersData, threadsData }) {
    try {
      const { threadID, senderID, body } = event;
      if (!body) return;

      const botID = String(api.getCurrentUserID());
      const uid = String(senderID);
      if (uid === botID) return;

      await checkAndCleanBan(usersData, uid);
      if (event.isGroup !== false) {
        await checkAndCleanBan(threadsData, threadID);
      }

      if (event.isGroup === false || getProtectedIDs().includes(uid)) return;

      const prefix = getPrefix(threadID);
      if (!prefix || !body.startsWith(prefix) || body.length === prefix.length) return;
      if (!(await antispamEnabled(threadsData, threadID))) return;

      const key = `${threadID}:${uid}`;
      const t = Date.now();
      const recent = (hits.get(key) || []).filter(x => t - x < SPAM_WINDOW);
      recent.push(t);
      hits.set(key, recent);
      if (recent.length < SPAM_LIMIT) return;
      hits.delete(key);

      const threadInfo = await getThreadInfo(api, threadID);
      const adminIDs = (threadInfo.adminIDs || []).map(a => String(a.id || a));
      if (adminIDs.includes(uid)) return;
      const botIsAdmin = adminIDs.includes(botID);

      const prev = offenses.get(key);
      const count = (prev && t - prev.last < OFFENSE_TTL ? prev.count : 0) + 1;
      offenses.set(key, { count, last: t });
      const name = await nameOf(usersData, uid);
      const mention = [{ tag: name, id: uid }];

      if (count < MAX_OFFENSES) {
        const left = MAX_OFFENSES - count;
        return message.reply({
          body: naruto(
            `AVERTISSEMENT ${count}/${MAX_OFFENSES}`,
            `Eh oh ${name}, tu te calmes tout de suite ?! Tu me spammes trop là, c'est super relou ! 😤\n\n` +
              `Encore ${left} fois et ${botIsAdmin ? "je te vire du groupe direct" : "je te ghoste à vie"} ! 💅`
          ),
          mentions: mention
        });
      }

      offenses.delete(key);
      let kicked = false;
      if (botIsAdmin) {
        try {
          await removeUser(api, uid, threadID);
          kicked = true;
        } catch (e) {
          console.error("[blackliste] expulsion impossible :", e?.message || e);
        }
      }

      if (kicked) {
        return message.reply(
          naruto(
            "VIRÉ(E) DU GROUPE !",
            `${name} a trop forcé avec le spam malgré mes avertissements. Allez hop, dehors ! 💅✨`
          )
        );
      }

      await usersData.set(uid, {
        banned: { status: true, reason: "Spam du bot (anti-spam automatique)", date: now(), expiresAt: null }
      });
      return message.reply({
        body: naruto(
          "GHOSTÉ(E) POUR SPAM !",
          `${name} m'a spammée ${MAX_OFFENSES} fois, quel forceur ! Je ne lui réponds plus. 🙄`
        ),
        mentions: mention
      });
    } catch (e) {
      console.error("[blackliste] anti-spam :", e?.message || e);
    }
  }
