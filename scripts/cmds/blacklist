/* ───── Anti-spam : réglages (modifie ces valeurs si tu veux) ───── */
const SPAM_LIMIT = 4;            // 4 commandes envoyées...
const SPAM_WINDOW = 6000;        // ...en 6 secondes = 1 infraction
const MAX_OFFENSES = 3;          // 3 infractions = expulsion
const OFFENSE_TTL = 30 * 60000;  // les infractions sont oubliées après 30 minutes
const hits = new Map();          // "groupe:utilisateur" -> heures des dernières commandes
const offenses = new Map();      // "groupe:utilisateur" -> { count, last }

// Les fonctions de l'API fca fonctionnent par callback : on les transforme en promesses
function getThreadInfo(api, threadID) {
  return new Promise((resolve, reject) =>
    api.getThreadInfo(threadID, (err, data) => (err ? reject(err) : resolve(data)))
  );
}
function removeUser(api, uid, threadID) {
  return new Promise((resolve, reject) =>
    api.removeUserFromGroup(uid, threadID, err => (err ? reject(err) : resolve()))
  );
}

function getPrefix(threadID) {
  try {
    return global.utils.getPrefix(threadID);
  } catch (_) {
    return (global.GoatBot && global.GoatBot.config && global.GoatBot.config.prefix) || "";
  }
}

function getProtectedIDs() {
  const cfg = (global.GoatBot && global.GoatBot.config) || {};
  return [...(cfg.adminBot || []), ...(cfg.devUsers || [])].map(String);
}

// L'anti-spam est actif par défaut ; `blackliste antispam off` le coupe dans un groupe
async function antispamEnabled(threadsData, threadID) {
  try {
    const v = await threadsData.get(threadID, "data.antispamBL");
    return v !== false;
  } catch (_) {
    return true;
  }
}

function naruto(title, body) {
  return `${FRAME}\n✨ ${title} ✨\n${body}`;
}

function now() {
  return new Date().toLocaleString("fr-FR", { timeZone: "Africa/Abidjan" });
}

/* ───── Gestion des durées (s, m, h, d) ───── */
const TIME_UNITS = { s: 1000, m: 60000, h: 3600000, d: 86400000 };

function parseDuration(tokens) {
  let totalMs = 0;
  const rest = [];
  for (const tok of tokens) {
    if (/^(?:\d+[smhd])+$/i.test(tok)) {
      for (const m of tok.matchAll(/(\d+)([smhd])/gi)) {
        totalMs += Number(m[1]) * TIME_UNITS[m[2].toLowerCase()];
      }
    } else {
      rest.push(tok);
    }
  }
  return { ms: totalMs > 0 ? totalMs : null, rest };
}

function formatDuration(ms) {
  if (!ms || ms <= 0) return "Permanent";
  let rem = Math.ceil(ms / 1000);
  const d = Math.floor(rem / 86400); rem %= 86400;
  const h = Math.floor(rem / 3600);  rem %= 3600;
  const m = Math.floor(rem / 60);    rem %= 60;
  const parts = [];
  if (d) parts.push(`${d}j`);
  if (h) parts.push(`${h}h`);
  if (m) parts.push(`${m}m`);
  if (rem && !d) parts.push(`${rem}s`);
  return parts.join(" ") || "0s";
}

async function checkAndCleanBan(store, id) {
  try {
    const data = await store.get(id);
    const banned = data?.banned;
    if (!banned || banned.status !== true) return null;
    if (banned.expiresAt && Date.now() >= banned.expiresAt) {
      await store.set(id, { banned: { status: false, reason: null, date: null, expiresAt: null } });
      return null;
    }
    return banned;
  } catch (_) {
    return null;
  }
}

function getTarget(event, args) {
  const mentions = event.mentions || {};
  const mentionIDs = Object.keys(mentions);

  if (event.messageReply) {
    const { ms, rest } = parseDuration(args);
    return { uid: String(event.messageReply.senderID), ms, reason: rest.join(" ").trim() };
  }
  if (mentionIDs.length) {
    let raw = args.join(" ");
    for (const n of Object.values(mentions)) raw = raw.replace(n, "");
    const tokens = raw.trim().split(/\s+/).filter(Boolean);
    const { ms, rest } = parseDuration(tokens);
    return { uid: String(mentionIDs[0]), ms, reason: rest.join(" ").trim() };
  }
  if (/^\d{5,}$/.test(args[0] || "")) {
    const { ms, rest } = parseDuration(args.slice(1));
    return { uid: args[0], ms, reason: rest.join(" ").trim() };
  }
  return null;
}

function getGroupTarget(event, args) {
  if (/^\d{5,}$/.test(args[0] || "")) {
    const { ms, rest } = parseDuration(args.slice(1));
    return { tid: args[0], ms, reason: rest.join(" ").trim() };
  }
  if (event.isGroup !== false) {
    const clean = ["this", "ici", "actuel"].includes((args[0] || "").toLowerCase()) ? args.slice(1) : args;
    const { ms, rest } = parseDuration(clean);
    return { tid: String(event.threadID), ms, reason: rest.join(" ").trim() };
  }
  return null;
}

async function nameOf(usersData, uid) {
  try {
    return (await usersData.getName(uid)) || uid;
  } catch (_) {
    return uid;
  }
}

async function threadNameOf(threadsData, tid) {
  try {
    return (await threadsData.getName(tid)) || tid;
  } catch (_) {
    return tid;
  }
}

